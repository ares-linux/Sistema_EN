# Ignorar carpetas de NetBeans (tanto en la raíz como en subcarpetas)
**/nbproject/private/

# Ignorar archivos de bases de datos y respaldos
database/*.db
backups/*

# Ignorar carpetas de compilación (build y dist) en cualquier parte del proyecto
build/
dist/

# Configuración local de la ruta de la base de datos
Sistema_en/base_de_datos.properties

# Credenciales de Google OAuth y tokens por-usuario (no versionar)
Sistema_en/credentials.json
Sistema_en/tokens/

# Carpetas generadas por jDeploy (artefactos de build con credenciales/tokens)
Sistema_en/jdeploy/
Sistema_en/jdeploy-bundle/
Sistema_en/icon.png
*.py

# Artefacto jDeploy generado por accidente en nbproject
Sistema_en/nbproject/package.json

# Respaldos que dejan las herramientas de parcheo (patch/mergediff)
*.orig
*.rej

# Directorio de trabajo personal para parches y pruebas sueltas
scratch/

# Salida generada de tree: se regenera con "tree -I 'build|dist|.git'"
estructura.txt
